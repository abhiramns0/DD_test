# Copy these into Render > your service > Environment. NEVER commit a real .env file to GitHub.
DATABASE_URL=postgresql://postgres.<project-ref>:<URL-ENCODED-PASSWORD>@aws-0-<region>.pooler.supabase.com:5432/postgres
# optional
ADMIN_KEY=<long-random-string>      # enables /admin/clear-leaderboard (developer-only reset)
# LB_MAX_LEVEL=200                  # highest level the server will accept as plausible
# DB_POOL_MAX=5
# DATABASE_SSL=off                  # ONLY for a local Postgres without TLS
